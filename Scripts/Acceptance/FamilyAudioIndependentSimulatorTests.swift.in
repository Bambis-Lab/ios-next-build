import CryptoKit
import Foundation
import XCTest
import UIKit
@testable import IOSNext

// This contract is compiled only into a disposable XCTest bundle. No
// production application reads it. An authorized provisioner must supply
// exactly one role's private file inside its isolated simulator container.
// Files, bearer values and private keys must never appear in CI artifacts.
private struct DistributedAudioRole:Decodable {
    let version:Int
    let role:String
    let callID:String
    let baseURL:String
    let duration:Int64
    let expiresAt:Int
    let signingSeed:String
    let peerSigningKey:String
    let peerAgreementKey:String
    let tokens:[String]
    let grantExpiries:[Int]

    private static func validHex(_ value:String,count:Int)->Bool {
        value.utf8.count==count && value.utf8.allSatisfy{(48...57).contains($0)||(97...102).contains($0)}
    }
    private static func key(_ value:String) throws -> Data {
        guard let data=Data(base64Encoded:value),data.count==32,data.base64EncodedString()==value
        else {throw FamilyAudioWireError.invalidCredential}
        return data
    }

    static func parse(_ data:Data,role:String,duration:Int64,now:Int) throws -> Self {
        guard data.count<=16384 else {throw FamilyAudioWireError.invalidCredential}
        // Do not propagate decoding errors that could include secret input.
        guard let value=try? JSONDecoder().decode(Self.self,from:data),
            value.version==1,["A","B"].contains(role),value.role==role,
            [30,120,300].contains(duration),value.duration==duration,
            validHex(value.callID,count:32),value.expiresAt>now+Int(duration),
            value.expiresAt<=now+1200,value.tokens.count==3,
            Set(value.tokens).count==3,value.tokens.allSatisfy({validHex($0,count:64)}),
            value.grantExpiries.count==3,value.grantExpiries[0]>now,
            value.grantExpiries[0]<value.grantExpiries[1],
            value.grantExpiries[1]<value.grantExpiries[2],
            value.grantExpiries[2]<=value.expiresAt,
            value.grantExpiries[2]>now+Int(duration),
            let origin=URLComponents(string:value.baseURL),origin.scheme=="https",
            let host=origin.host,!host.isEmpty,origin.user==nil,origin.password==nil,
            origin.query==nil,origin.fragment==nil,["","/"].contains(origin.percentEncodedPath)
        else {throw FamilyAudioWireError.invalidCredential}
        let privateKey=try Curve25519.Signing.PrivateKey(rawRepresentation:key(value.signingSeed))
        let peer=try key(value.peerSigningKey)
        _=try Curve25519.Signing.PublicKey(rawRepresentation:peer)
        _=try Curve25519.KeyAgreement.PublicKey(rawRepresentation:key(value.peerAgreementKey))
        guard privateKey.publicKey.rawRepresentation != peer else {throw FamilyAudioWireError.invalidCredential}
        return value
    }

    static func load(role:String,duration:Int64) throws -> Self {
        guard let dir=FileManager.default.urls(for:.applicationSupportDirectory,in:.userDomainMask).first
        else {throw FamilyAudioWireError.invalidCredential}
        let url=dir.appendingPathComponent("iosnext-v64-test-role.json")
        // No fallback to the deterministic fixture in distributed mode.
        guard let metadata=try? url.resourceValues(forKeys:[.isRegularFileKey,.isSymbolicLinkKey,.fileSizeKey]),
              metadata.isRegularFile==true,metadata.isSymbolicLink != true,
              let size=metadata.fileSize,size<=16384,
              let data=try? Data(contentsOf:url),data.count==size
        else {throw FamilyAudioWireError.invalidCredential}
        return try parse(data,role:role,duration:duration,now:Int(Date().timeIntervalSince1970))
    }

    func signing() throws -> Curve25519.Signing.PrivateKey {
        try .init(rawRepresentation:Self.key(signingSeed))
    }
    func peer(_ identity:[String]) -> ChatIdentity {
        .init(userID:identity[0],deviceID:identity[1],agreementPublicKey:peerAgreementKey,
              signingPublicKey:peerSigningKey,updatedAt:nil)
    }
    func endpoint() throws -> URL {
        guard var origin=URLComponents(string:baseURL) else {throw FamilyAudioWireError.invalidEndpoint}
        origin.scheme="wss"
        origin.path="/v1/audio"
        guard let url=origin.url else {throw FamilyAudioWireError.invalidEndpoint}
        return url
    }
}

// Only copied into a disposable hosted-runner checkout. Each test is executed
// in a distinct booted simulator, with independent ephemeral keys and socket.
final class FamilyAudioIndependentSimulatorTests: XCTestCase {
    @MainActor
    func testSimulatorA() async throws { try await exercise(roleA:true) }

    @MainActor
    func testSimulatorB() async throws { try await exercise(roleA:false) }

    @MainActor
    func testDistributedA() async throws { try await exercise(roleA:true,distributed:true) }

    @MainActor
    func testDistributedB() async throws { try await exercise(roleA:false,distributed:true) }

    /// Real execution inside the exact simulator; no network or credentials.
    @MainActor
    func testNativeExecutionPrerequisite() throws {
        #if targetEnvironment(simulator)
        XCTAssertEqual(ProcessInfo.processInfo.operatingSystemVersion.majorVersion,27)
        XCTAssertEqual(UIDevice.current.userInterfaceIdiom,.phone)
        let signing=Curve25519.Signing.PrivateKey()
        let challenge=Data("iosnext-v64-native-preflight".utf8)
        let signature=try signing.signature(for:challenge)
        XCTAssertTrue(signing.publicKey.isValidSignature(signature,for:challenge))
        // The role parser is also exercised using independent, fresh,
        // synthetic test data. None of this data is uploaded or printed.
        let now=Int(Date().timeIntervalSince1970)
        let peerKey=Curve25519.Signing.PrivateKey()
        let agreement=Curve25519.KeyAgreement.PrivateKey()
        var raw:[String:Any]=["version":1,"role":"A","callID":String(repeating:"b",count:32),
            "baseURL":"https://fixture.invalid/","duration":30,"expiresAt":now+300,
            "signingSeed":signing.rawRepresentation.base64EncodedString(),
            "peerSigningKey":peerKey.publicKey.rawRepresentation.base64EncodedString(),
            "peerAgreementKey":agreement.publicKey.rawRepresentation.base64EncodedString(),
            "tokens":["1","2","3"].map{String(repeating:$0,count:64)},
            "grantExpiries":[now+60,now+120,now+180]]
        func parse(_ role:String="A") throws -> DistributedAudioRole {
            try DistributedAudioRole.parse(JSONSerialization.data(withJSONObject:raw),role:role,duration:30,now:now)
        }
        let config=try parse()
        XCTAssertEqual(try config.endpoint().absoluteString,"wss://fixture.invalid/v1/audio")
        XCTAssertThrowsError(try parse("B"))
        raw["baseURL"]="http://fixture.invalid/"
        XCTAssertThrowsError(try parse())
        raw["baseURL"]="https://fixture.invalid/"
        raw["tokens"]=Array(repeating:String(repeating:"1",count:64),count:3)
        XCTAssertThrowsError(try parse())
        raw["tokens"]=["1","2","3"].map{String(repeating:$0,count:64)}
        raw["peerSigningKey"]=signing.publicKey.rawRepresentation.base64EncodedString()
        XCTAssertThrowsError(try parse())
        print("V64_NATIVE_EXECUTION_PREREQUISITE=PASS")
        #else
        XCTFail("Simulator prerequisite requires an iOS simulator")
        #endif
    }

    private func frame(sequence:UInt64,marker:UInt8) -> Data {
        var seq=sequence.bigEndian
        return withUnsafeBytes(of:&seq) {Data($0)} + Data(repeating:marker,count:632)
    }

    @MainActor
    private func exercise(roleA:Bool,distributed:Bool=false) async throws {
        let a=["ha-fixture-a","ios-a"], b=["ha-fixture-b","ios-b"]
        let local=roleA ? a : b
        let peer=roleA ? b : a
        let role=roleA ? "A" : "B"
        let marker:UInt8=roleA ? 31 : 73
        let peerMarker:UInt8=roleA ? 73 : 31
        let duration:Int64 = @DURATION_SECONDS@
        let roleConfig=distributed ? try DistributedAudioRole.load(role:role,duration:duration) : nil
        let context=try FamilyAudioContext(callID:roleConfig?.callID ?? String(repeating:"a",count:32),caller:a,callee:b,local:local)
        let keys:ChatDeviceKeys
        let verifiedPeer:ChatIdentity
        let tokens:[String]
        let expiries:[Int]
        let baseURL:URL
        let endpoint:URL
        if let value=roleConfig {
            keys=ChatDeviceKeys(agreement:.init(),signing:try value.signing())
            verifiedPeer=value.peer(peer)
            tokens=value.tokens
            expiries=value.grantExpiries
            guard let url=URL(string:value.baseURL) else {throw FamilyAudioWireError.invalidEndpoint}
            baseURL=url
            endpoint=try value.endpoint()
        } else {
            keys=ChatDeviceKeys(agreement:.init(),signing:try .init(rawRepresentation:Data(repeating:roleA ? 11 : 12,count:32)))
            let peerKeys=ChatDeviceKeys(agreement:.init(),signing:try .init(rawRepresentation:Data(repeating:roleA ? 12 : 11,count:32)))
            verifiedPeer=peerKeys.publicIdentity(userID:peer[0],deviceID:peer[1])
            let token=roleA ? "fixture-a" : "fixture-b"
            tokens=[token,token+"-renewed",token+"-renewed2"]
            expiries=[100,200,300]
            baseURL=try XCTUnwrap(URL(string:"https://127.0.0.1:18767/"))
            endpoint=try XCTUnwrap(URL(string:"wss://127.0.0.1:18767/v1/audio"))
        }
        let config=ChatConfiguration(baseURL:baseURL,token:tokens[0],userID:local[0],deviceID:local[1])
        let wire=try FamilyAudioWire(configuration:config,endpoint:endpoint,context:context)
        defer {wire.close()}
        let clock=ContinuousClock()
        try await wire.connect()
        let handshake=FamilyAudioHandshake(context:context)
        _ = try await wire.send(.offer(handshake.offer(signingKey:keys.signing)))
        let offerLimit=clock.now.advanced(by:.seconds(180))
        var peerOffer:FamilyAudioOffer?
        while peerOffer==nil && clock.now<offerLimit {
            peerOffer=try await wire.send(.peerOffer).offer
            if peerOffer==nil {try await Task.sleep(for:.milliseconds(250))}
        }
        let codec=try handshake.establish(peerOffer:XCTUnwrap(peerOffer),
            verifiedPeer:verifiedPeer)
        var received:UInt64=0
        func drain() throws {
            for packet in wire.takePackets() {
                guard packet.sequence==received else {
                    XCTFail("Sequence discontinuity: expected \(received), received \(packet.sequence)")
                    throw FamilyAudioError.invalidSequence
                }
                let plain=try codec.open(sequence:packet.sequence,packet:packet.validatedCiphertext())
                guard plain==frame(sequence:received,marker:peerMarker) else {
                    XCTFail("Peer payload mismatch")
                    throw FamilyAudioError.invalidFrame
                }
                received += 1
            }
        }
        // Bidirectional authenticated frame zero is the rendezvous: neither
        // process starts its timed media interval until it has decrypted it.
        _ = try await wire.send(.push(sequence:0,ciphertext:codec.seal(sequence:0,frame:frame(sequence:0,marker:marker))))
        let readyLimit=clock.now.advanced(by:.seconds(10))
        while received==0 && clock.now<readyLimit {
            try drain()
            if received==0 {try await Task.sleep(for:.milliseconds(5))}
        }
        XCTAssertGreaterThanOrEqual(received,1)
        guard received>=1 else {throw FamilyAudioWireError.transportClosed}
        let start=clock.now
        let mediaWallStarted=Date().timeIntervalSince1970
        var renewals=0
        let target=UInt64(duration)*50
        let firstRenewal=target/3,secondRenewal=2*target/3
        var sent:UInt64=0
        for sequence in UInt64(1)...target {
            try await clock.sleep(until:start.advanced(by:.milliseconds(Int64(sequence)*20)))
            if sequence==firstRenewal || sequence==secondRenewal {
                let index=sequence==firstRenewal ? 1 : 2
                let renewal=try await wire.send(.refresh(tokens[index]))
                XCTAssertEqual(renewal.expiresAt,expiries[index])
                renewals += 1
            }
            let encrypted=try codec.seal(sequence:sequence,frame:frame(sequence:sequence,marker:marker))
            guard try await wire.sendMedia(sequence:sequence,ciphertext:encrypted) else {
                XCTFail("Media send-window saturated")
                throw FamilyAudioWireError.queueFull
            }
            sent += 1
            try drain()
        }
        let mediaElapsed=start.duration(to:clock.now)
        let mediaWallFinished=Date().timeIntervalSince1970
        XCTAssertGreaterThanOrEqual(mediaElapsed,.seconds(duration))
        _ = try await wire.send(.heartbeat) // ordered media acknowledgement barrier
        let finalLimit=clock.now.advanced(by:.seconds(8))
        while received<target+1 && clock.now<finalLimit {
            try drain()
            if received<target+1 {try await Task.sleep(for:.milliseconds(5))}
        }
        XCTAssertEqual(sent,target)
        XCTAssertEqual(received,target+1)
        XCTAssertTrue(wire.isConnected)
        // Stay alive while the peer finishes its barrier. No extra audio,
        // no new nonce, no retry; heartbeat prevents idle disconnection.
        try await Task.sleep(for:.seconds(2))
        try drain()
        XCTAssertEqual(received,target+1)
        let elapsed=start.duration(to:clock.now)
        XCTAssertGreaterThanOrEqual(elapsed,.seconds(duration))
        let udid=ProcessInfo.processInfo.environment["SIMULATOR_UDID"] ?? "unavailable"
        if distributed {
            let seconds=Double(mediaElapsed.components.seconds)+Double(mediaElapsed.components.attoseconds)/1e18
            let relayDigest=SHA256.hash(data:Data(context.callID.utf8)).map{String(format:"%02x",$0)}.joined()
            // Non-secret evidence only, never the role file, bearer or key.
            print("V64_NATIVE_MEDIA role=\(role) sent=\(sent) received=\(received-1) renewals=\(renewals) elapsed=\(seconds) started=\(mediaWallStarted) finished=\(mediaWallFinished) relay=\(relayDigest)")
        }
        print("IOS173_DUAL_RESULT role=\(role) udid=\(udid) pid=\(ProcessInfo.processInfo.processIdentifier) sent=\(sent) received=\(received-1) elapsed=\(mediaElapsed.components.seconds)")
    }
}
